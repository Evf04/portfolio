---
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.replace(/\/$/, "");
---

<header class="topbar" aria-label="Primary navigation">
  <div class="topbar-inner">
    <a class="brand" href="/" aria-label="Home">
      Elias Velasquez<span class="brand-dot">.</span>
    </a>


    <nav class="nav-links" aria-label="Main menu">
      <a href="/about" class={currentPath === "/about" ? "active" : ""} data-en="About" data-es="Sobre mí">About</a>
      <a href="/work" class={currentPath === "/work" ? "active" : ""} data-en="Work" data-es="Trabajo">Work</a>
      <a href="/contact" class={currentPath === "/contact" ? "active" : ""} data-en="Contact" data-es="Contacto">Contact</a>
    </nav>

    <div class="topbar-actions">
      <a
        href="https://www.linkedin.com/in/eliasvf"
        target="_blank"
        rel="noopener noreferrer"
        class="social-btn linkedin-btn"
        aria-label="LinkedIn profile"
        title="LinkedIn profile"
      >
        <svg class="social-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
          <rect x="2" y="9" width="4" height="12"></rect>
          <circle cx="4" cy="4" r="2"></circle>
        </svg>
      </a>

      <button class="lang-toggle" type="button" aria-label="Switch language">
        <span class="lang-en active" aria-hidden="true">EN</span>
        <span class="lang-separator" aria-hidden="true">/</span>
        <span class="lang-es" aria-hidden="true">ES</span>
      </button>

      <button class="theme-toggle" type="button" aria-label="Toggle dark/light theme" id="themeToggle" title="Toggle theme">
        <svg class="theme-icon moon-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
        <svg class="theme-icon sun-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="12" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
      </button>



      <button class="mobile-nav-toggle" id="mobileNavToggle" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="mobileMenu">
        <span aria-hidden="true">☰</span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobileMenu">
    <a href="/" class={currentPath === "" ? "active" : ""} data-en="Home" data-es="Inicio">Home</a>
    <a href="/about" class={currentPath === "/about" ? "active" : ""} data-en="About" data-es="Sobre mí">About</a>
    <a href="/work" class={currentPath === "/work" ? "active" : ""} data-en="Work" data-es="Trabajo">Work</a>
    <a href="/contact" class={currentPath === "/contact" ? "active" : ""} data-en="Contact" data-es="Contacto">Contact</a>
    <a href="https://www.linkedin.com/in/eliasvf" target="_blank" rel="noopener noreferrer" class="mobile-external-link">LinkedIn ↗</a>
  </div>
</header>


<script is:inline>
  // Mobile Nav Toggle Logic with Accessibility & Escape Key Handling
  const mobileToggle = document.getElementById("mobileNavToggle");
  const mobileMenu = document.getElementById("mobileMenu");

  function setMobileMenu(open) {
    if (open) {
      mobileMenu?.classList.add("open");
      mobileToggle?.setAttribute("aria-expanded", "true");
    } else {
      mobileMenu?.classList.remove("open");
      mobileToggle?.setAttribute("aria-expanded", "false");
    }
  }

  mobileToggle?.addEventListener("click", () => {
    const isOpen = mobileMenu?.classList.contains("open");
    setMobileMenu(!isOpen);
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && mobileMenu?.classList.contains("open")) {
      setMobileMenu(false);
      mobileToggle?.focus();
    }
  });
</script>

