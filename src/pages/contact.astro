---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Contact Elias Velasquez | Systems Engineer & Developer"
  description="Get in direct touch with Elias Velasquez Fuentes for software engineering roles, web platforms, and technical collaboration."
>
  <main class="page-container contact-page">
    <header class="contact-header">
      <h1 class="page-title">
        <span data-en="Let's connect & build" data-es="Conectemos y construyamos">Let's connect & build</span>
        <strong data-en="something impactful." data-es="algo de gran impacto.">something impactful.</strong>
      </h1>

      <p class="page-description" data-en="Whether you have an engineering role, a brand platform project, or want to discuss technical systems, reach out directly through the channels below." data-es="Ya sea que tengas una oportunidad laboral, un proyecto de plataforma web o desees conversar sobre sistemas, contáctame directamente por los siguientes canales.">
        Whether you have an engineering role, a brand platform project, or want to discuss technical systems, reach out directly through the channels below.
      </p>
    </header>

    <!-- Minimal Direct Contact Grid -->
    <div class="contact-direct-grid">
      <!-- Primary Email Card -->
      <div class="direct-card primary-channel">
        <div class="channel-meta">
          <span class="channel-badge" data-en="Primary Contact" data-es="Contacto Principal">Primary Contact</span>
          <span class="channel-note" data-en="Replies within 24 hours" data-es="Respuesta en menos de 24 horas">Replies within 24 hours</span>
        </div>

        <h2 class="channel-title" data-en="Direct Email" data-es="Correo Directo">Direct Email</h2>
        <a href="mailto:eliasvelasquezf0404@gmail.com" class="channel-link">
          eliasvelasquezf0404@gmail.com
        </a>

        <div class="channel-actions">
          <a href="mailto:eliasvelasquezf0404@gmail.com" class="btn-email-action">
            <span data-en="Send an Email" data-es="Enviar Correo">Send an Email</span>
            <span aria-hidden="true">&#8599;</span>
          </a>
          <button id="copyEmailBtn" class="btn-copy-action" type="button">
            <span id="copyText" data-en="Copy Email" data-es="Copiar Correo">Copy Email</span>
          </button>
        </div>
      </div>

      <!-- Developer Profiles & Location Card -->
      <div class="direct-card info-channel">
        <div class="channel-meta">
          <span class="channel-badge" data-en="Profiles & Location" data-es="Perfiles y Ubicación">Profiles & Location</span>
        </div>

        <h2 class="channel-title" data-en="Online Presence" data-es="Presencia Online">Online Presence</h2>

        <div class="profile-links-list">
          <a href="https://github.com/Evf04" target="_blank" rel="noopener noreferrer" class="profile-link-item">
            <div class="profile-item-text">
              <strong>GitHub</strong>
              <span>github.com/Evf04</span>
            </div>
            <span aria-hidden="true" class="link-arrow">&#8599;</span>
          </a>

          <div class="profile-info-row">
            <div class="profile-item-text">
              <span class="info-label" data-en="Location" data-es="Ubicación">Location</span>
              <strong class="info-val">Cartagena, Colombia</strong>
            </div>
          </div>

          <div class="profile-info-row">
            <div class="profile-item-text">
              <span class="info-label" data-en="University" data-es="Universidad">University</span>
              <strong class="info-val">Universidad de Cartagena</strong>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script is:inline>
    const copyBtn = document.getElementById("copyEmailBtn");
    const copyText = document.getElementById("copyText");
    const email = "eliasvelasquezf0404@gmail.com";

    copyBtn?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(email);
        const isEs = document.documentElement.getAttribute("lang") === "es";
        copyText.textContent = isEs ? "¡Copiado!" : "Copied!";
        setTimeout(() => {
          const currentLang = document.documentElement.getAttribute("lang") || "en";
          copyText.textContent = currentLang === "es" ? "Copiar Correo" : "Copy Email";
        }, 2500);
      } catch (err) {
        window.location.href = `mailto:${email}`;
      }
    });
  </script>
</Layout>
