---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Contact Elias Velasquez | Systems Engineer & Developer"
  description="Get in direct touch with Elias Velasquez Fuentes for software engineering roles, web platforms, and technical collaboration."
>
  <main class="page-container contact-page">
    <div class="contact-wrapper">
      <header class="contact-header">
        <h1 class="page-title">
          <strong data-en="Say hello." data-es="Escríbeme.">Say hello.</strong>
        </h1>

        <p class="page-description" data-en="Whether you have an open role, a web project, or just want to talk tech, feel free to reach out." data-es="Ya sea que tengas una oferta laboral, un proyecto web o quieras conversar sobre tecnología, escríbeme con total confianza.">
          Whether you have an open role, a web project, or just want to talk tech, feel free to reach out.
        </p>
      </header>

      <!-- Single Unified Contact Card -->
      <div class="contact-single-card">
        <div class="card-meta">
          <span class="channel-badge" data-en="Direct Email" data-es="Correo Directo">Direct Email</span>
        </div>

        <div class="card-main-row">
          <span class="main-email-text">
            eliasvelasquezf0404@gmail.com
          </span>

          <a 
            href="https://mail.google.com/mail/?view=cm&fs=1&to=eliasvelasquezf0404@gmail.com" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="btn-email-action"
          >
            <span data-en="Send an Email" data-es="Enviar Correo">Send an Email</span>
            <svg class="btn-arrow" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </a>
        </div>

        <div class="card-footer-meta">
          <a href="https://github.com/Evf04" target="_blank" rel="noopener noreferrer" class="footer-meta-item footer-meta-link">
            <span class="meta-label">GitHub</span>
            <span class="meta-val">github.com/Evf04 ↗</span>
          </a>
          <a href="https://www.linkedin.com/in/eliasvf" target="_blank" rel="noopener noreferrer" class="footer-meta-item footer-meta-link">
            <span class="meta-label">LinkedIn</span>
            <span class="meta-val">linkedin.com/in/eliasvf ↗</span>
          </a>
          <div class="footer-meta-item">
            <span class="meta-label" data-en="Location" data-es="Ubicación">Location</span>
            <span class="meta-val">Cartagena, Colombia</span>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>
