    <!-- Image Preview Lightbox Modal -->
    <div class="image-lightbox" id="imageLightbox" role="dialog" aria-modal="true" aria-hidden="true" aria-label="Image Preview">
      <div class="lightbox-overlay" id="lightboxOverlay"></div>
      <div class="lightbox-container">
        <button class="lightbox-close" id="lightboxClose" type="button" aria-label="Close preview">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
        <div class="lightbox-media">
          <img id="lightboxImg" src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1 1'%3E%3C/svg%3E" alt="Enlarged snapshot preview" />
        </div>
        <p class="lightbox-caption" id="lightboxCaption"></p>
      </div>
    </div>
  </main>

  <script is:inline>
    function initWorkInteractiveSnapshots() {
      const lightbox = document.getElementById("imageLightbox");
      const lightboxImg = document.getElementById("lightboxImg");
      const lightboxCaption = document.getElementById("lightboxCaption");
      const lightboxClose = document.getElementById("lightboxClose");
      const lightboxOverlay = document.getElementById("lightboxOverlay");

      function openLightbox(src, alt, captionText) {
        if (!lightbox || !lightboxImg) return;
        lightboxImg.src = src;
        lightboxImg.alt = alt || "Enlarged preview";
        if (lightboxCaption) {
          lightboxCaption.textContent = captionText || "";
        }
        lightbox.classList.add("active");
        lightbox.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
      }

      function closeLightbox() {
        if (!lightbox) return;
        lightbox.classList.remove("active");
        lightbox.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
        if (lightboxImg) {
          lightboxImg.src = "";
        }
      }

      if (lightboxClose) lightboxClose.onclick = closeLightbox;
      if (lightboxOverlay) lightboxOverlay.onclick = closeLightbox;
      if (lightboxImg) lightboxImg.onclick = closeLightbox;

      document.onkeydown = (e) => {
        if (e.key === "Escape" && lightbox?.classList.contains("active")) {
          closeLightbox();
        }
      };

      function swapSnapshots(mainSlot, thumbSlot) {
        const mainFrame = mainSlot.querySelector(".snapshot-frame");
        const thumbFrame = thumbSlot.querySelector(".snapshot-frame");
        const mainImg = mainFrame?.querySelector("img");
        const thumbImg = thumbFrame?.querySelector("img");
        const mainCaption = mainSlot.querySelector(".snap-caption");
        const thumbCaption = thumbSlot.querySelector(".snap-caption");

        if (!mainImg || !thumbImg || !mainCaption || !thumbCaption) return;

        mainFrame.classList.add("snap-swapping");
        thumbFrame.classList.add("snap-swapping");
        mainCaption.classList.add("snap-swapping");

        setTimeout(() => {
          // Swap image attributes
          const tempSrc = mainImg.src;
          const tempAlt = mainImg.alt;
          const tempWidth = mainImg.getAttribute("width");
          const tempHeight = mainImg.getAttribute("height");

          mainImg.src = thumbImg.src;
          mainImg.alt = thumbImg.alt;
          if (thumbImg.getAttribute("width")) mainImg.setAttribute("width", thumbImg.getAttribute("width"));
          if (thumbImg.getAttribute("height")) mainImg.setAttribute("height", thumbImg.getAttribute("height"));

          thumbImg.src = tempSrc;
          thumbImg.alt = tempAlt;
          if (tempWidth) thumbImg.setAttribute("width", tempWidth);
          if (tempHeight) thumbImg.setAttribute("height", tempHeight);

          // Swap caption attributes and inner lang-text spans
          const tempEn = mainCaption.getAttribute("data-en") || "";
          const tempEs = mainCaption.getAttribute("data-es") || "";

          const thumbEn = thumbCaption.getAttribute("data-en") || "";
          const thumbEs = thumbCaption.getAttribute("data-es") || "";

          mainCaption.setAttribute("data-en", thumbEn);
          mainCaption.setAttribute("data-es", thumbEs);
          const mainEnSpan = mainCaption.querySelector(".lang-en");
          const mainEsSpan = mainCaption.querySelector(".lang-es");
          if (mainEnSpan && mainEsSpan) {
            mainEnSpan.textContent = thumbEn;
            mainEsSpan.textContent = thumbEs;
          } else {
            const currentLang = document.documentElement.getAttribute("data-lang") || document.documentElement.getAttribute("lang") || "en";
            mainCaption.textContent = currentLang === "es" ? thumbEs : thumbEn;
          }

          thumbCaption.setAttribute("data-en", tempEn);
          thumbCaption.setAttribute("data-es", tempEs);
          const thumbEnSpan = thumbCaption.querySelector(".lang-en");
          const thumbEsSpan = thumbCaption.querySelector(".lang-es");
          if (thumbEnSpan && thumbEsSpan) {
            thumbEnSpan.textContent = tempEn;
            thumbEsSpan.textContent = tempEs;
          } else {
            const currentLang = document.documentElement.getAttribute("data-lang") || document.documentElement.getAttribute("lang") || "en";
            thumbCaption.textContent = currentLang === "es" ? tempEs : tempEn;
          }

          requestAnimationFrame(() => {
            mainFrame.classList.remove("snap-swapping");
            thumbFrame.classList.remove("snap-swapping");
            mainCaption.classList.remove("snap-swapping");
          });
        }, 140);
      }

      const galleries = document.querySelectorAll(".dossier-snapshots");
      galleries.forEach((gallery) => {
        if (gallery.classList.contains("snapshots-duo")) {
          const slots = gallery.querySelectorAll(".snapshot-slot");
          slots.forEach((slot) => {
            const frame = slot.querySelector(".snapshot-frame");
            if (!frame) return;

            frame.classList.add("clickable-snap");
            frame.setAttribute("tabindex", "0");
            frame.setAttribute("role", "button");
            frame.setAttribute("aria-label", "Ver imagen ampliada / Enlarge snapshot preview");

            frame.onclick = () => {
              const img = frame.querySelector("img");
              const captionEl = slot.querySelector(".snap-caption");
              if (img) {
                openLightbox(img.src, img.alt, captionEl?.textContent || "");
              }
            };

            frame.onkeydown = (e) => {
              if (e.key === "Enter" || e.key === " ") {
                e.preventDefault();
                frame.click();
              }
            };
          });
          return;
        }

        const mainSlot = gallery.querySelector(".snapshot-slot.main-snap");
        const subGrid = gallery.querySelector(".snapshot-sub-grid");
        if (!mainSlot || !subGrid) return;

        const mainFrame = mainSlot.querySelector(".snapshot-frame");
        if (mainFrame) {
          mainFrame.classList.add("clickable-snap");
          mainFrame.setAttribute("tabindex", "0");
          mainFrame.setAttribute("role", "button");
          mainFrame.setAttribute("aria-label", "Ver imagen ampliada / Enlarge snapshot preview");

          mainFrame.onclick = () => {
            const mainImg = mainFrame.querySelector("img");
            const captionEl = mainSlot.querySelector(".snap-caption");
            if (mainImg) {
              openLightbox(mainImg.src, mainImg.alt, captionEl?.textContent || "");
            }
          };

          mainFrame.onkeydown = (e) => {
            if (e.key === "Enter" || e.key === " ") {
              e.preventDefault();
              mainFrame.click();
            }
          };
        }

        const thumbSlots = subGrid.querySelectorAll(".snapshot-slot");
        thumbSlots.forEach((thumbSlot) => {
          const thumbFrame = thumbSlot.querySelector(".snapshot-frame");
          if (!thumbFrame) return;

          thumbFrame.classList.add("clickable-snap");
          thumbFrame.setAttribute("tabindex", "0");
          thumbFrame.setAttribute("role", "button");
          thumbFrame.setAttribute("aria-label", "Toca para ver en vista principal / Tap to switch to main preview");

          thumbFrame.onclick = () => {
            const isTabletOrMobile = window.matchMedia("(max-width: 1040px)").matches;
            if (isTabletOrMobile) {
              swapSnapshots(mainSlot, thumbSlot);
            } else {
              const thumbImg = thumbFrame.querySelector("img");
              const captionEl = thumbSlot.querySelector(".snap-caption");
              if (thumbImg) {
                openLightbox(thumbImg.src, thumbImg.alt, captionEl?.textContent || "");
              }
            }
          };

          thumbFrame.onkeydown = (e) => {
            if (e.key === "Enter" || e.key === " ") {
              e.preventDefault();
              thumbFrame.click();
            }
          };
        });
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initWorkInteractiveSnapshots);
    } else {
      initWorkInteractiveSnapshots();
    }
    document.addEventListener("astro:page-load", initWorkInteractiveSnapshots);
  </script>
</Layout>
