---
import Layout from "../layouts/Layout.astro";
import WaveArt from "../components/WaveArt.astro";
---

<Layout
  title="Elias Velasquez | Front-End & Full-Stack Developer"
  description="Portfolio of Elias Velasquez Fuentes - Systems Engineering student and Front-End/Full-Stack Developer specializing in Astro, TypeScript, Sass, Supabase, and PostgreSQL."
>
  <main class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">
        <span aria-hidden="true">&lt;/&gt;</span>
        <span data-en="Front-End / Full-Stack Developer" data-es="Desarrollador Front-End / Full-Stack">Front-End / Full-Stack Developer</span>
      </p>

      <h1 id="hero-title" class="hero-heading">
        <span data-en="Developing web" data-es="Desarrollando">Developing web</span>
        <span data-en="experiences that" data-es="experiencias web que">experiences that</span>
        <strong data-en="work for businesses." data-es="funcionan para empresas.">work for businesses.</strong>
      </h1>

      <p class="intro">
        <span data-en="Crafting high-performance web applications and brand platforms for Adidas events —" data-es="Construyendo aplicaciones web de alto rendimiento y plataformas para eventos de Adidas —">Crafting high-performance web applications and brand platforms for Adidas events —</span>
        <span data-en="from rapid booking flows to full database integrations" data-es="desde flujos de reserva rápidos hasta integración de bases de datos">from rapid booking flows to full database integrations </span> 
        <span data-en="with Astro, TypeScript, Supabase, and PostgreSQL." data-es="con Astro, TypeScript, Supabase y PostgreSQL.">with Astro, TypeScript, Supabase, and PostgreSQL.</span>
      </p>

      <div class="hero-actions">
        <a class="impact-link" href="/work">
          <span data-en="See my work & case studies" data-es="Ver trabajos y casos de estudio">See my work & case studies</span>
          <span aria-hidden="true">-&gt;</span>
        </a>
        <a class="secondary-action" href="/about">
          <span data-en="About Elias" data-es="Sobre Elias">About Elias</span>
        </a>
      </div>

      <div class="scroll-mark" aria-hidden="true">( ) SCROLL FOR CASE STUDIES</div>
    </div>

    <WaveArt />
  </main>
</Layout>
