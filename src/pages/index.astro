---
import Layout from "../layouts/Layout.astro";
import WaveArt from "../components/WaveArt.astro";
---

<Layout
  title="Elias Velasquez | Full-Stack Developer"
  description="Portfolio of Elias Velasquez Fuentes - Systems Engineering student and Full-Stack Developer specializing in Astro, JavaScript, Sass, Supabase, and PostgreSQL."
>
  <main class="hero" aria-labelledby="hero-title">
    <div class="hero-inner">
      <div class="hero-copy">
        <h1 id="hero-title" class="hero-heading">
          <span class="hero-greeting" data-en="Hi, I'm Elias Velasquez" data-es="Hola, soy Elías Velásquez">
            <span class="lang-text lang-en">Hi, I'm Elias Velasquez</span>
            <span class="lang-text lang-es">Hola, soy Elías Velásquez</span>
          </span>
          <span data-en="Full-stack developer in" data-es="Desarrollador full-stack en">
            <span class="lang-text lang-en">Full-stack developer in</span>
            <span class="lang-text lang-es">Desarrollador full-stack en</span>
          </span>
          <strong data-en="Cartagena, Colombia." data-es="Cartagena, Colombia.">Cartagena, Colombia.</strong>
        </h1>

        <p class="intro">
          <span data-en="Engineering fast web systems and relational PostgreSQL architectures for brand events and production." data-es="Construyo sistemas web rápidos y arquitecturas relacionales en PostgreSQL para eventos de marca y producción.">
            <span class="lang-text lang-en">Engineering fast web systems and relational PostgreSQL architectures for brand events and production.</span>
            <span class="lang-text lang-es">Construyo sistemas web rápidos y arquitecturas relacionales en PostgreSQL para eventos de marca y producción.</span>
          </span>
          <span data-en="Systems Engineering senior at Universidad de Cartagena." data-es="Estudiante de último año de Ingeniería de Sistemas en la Universidad de Cartagena.">
            <span class="lang-text lang-en">Systems Engineering senior at Universidad de Cartagena.</span>
            <span class="lang-text lang-es">Estudiante de último año de Ingeniería de Sistemas en la Universidad de Cartagena.</span>
          </span>
        </p>

        <div class="hero-actions">
          <a class="impact-link" href="/work">
            <span data-en="View case studies" data-es="Ver casos de estudio">
              <span class="lang-text lang-en">View case studies</span>
              <span class="lang-text lang-es">Ver casos de estudio</span>
            </span>
          </a>
          <a class="hero-sub-link" href="/about">
            <span data-en="About me" data-es="Sobre mí">
              <span class="lang-text lang-en">About me</span>
              <span class="lang-text lang-es">Sobre mí</span>
            </span>
          </a>
        </div>
      </div>

      <!-- Right-Side Visual: Hybrid Showcase Stage -->
      <div class="hero-visual" aria-label="Interactive Showcase">
        <div class="hero-showcase-stage" aria-label="Featured Projects Showcase">
          <!-- Mobile & Tablet Carousel Title Bar (Visible on <= 1040px) -->
          <div class="stage-carousel-header" aria-label="Project carousel navigation">
            <button class="carousel-arrow-btn prev" type="button" aria-label="Previous project" id="carousel-btn-prev">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>
            <span class="carousel-title" id="carousel-active-title">
              <span class="lang-text lang-en">Sorteo Adidas Oasis</span>
              <span class="lang-text lang-es">Sorteo Adidas Oasis</span>
            </span>
            <button class="carousel-arrow-btn next" type="button" aria-label="Next project" id="carousel-btn-next">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
          </div>

          <!-- Project Tabs (Vertical sidebar on desktop, hidden on mobile) -->
          <div class="stage-dossier-list" role="tablist" aria-label="Featured projects dossier">
            <button
              class="stage-dossier-item active"
              role="tab"
              aria-selected="true"
              aria-controls="panel-sorteo"
              id="tab-sorteo"
              data-target="panel-sorteo"
              data-title-en="Sorteo Adidas Oasis"
              data-title-es="Sorteo Adidas Oasis"
              type="button"
            >
              <span class="dossier-indicator" aria-hidden="true"></span>
              <div class="dossier-text">
                <span class="dossier-name" data-en="Sorteo Adidas Oasis" data-es="Sorteo Adidas Oasis">Sorteo Adidas Oasis</span>
              </div>
            </button>

            <button
              class="stage-dossier-item"
              role="tab"
              aria-selected="false"
              aria-controls="panel-superstar"
              id="tab-superstar"
              data-target="panel-superstar"
              data-title-en="Hotel Superstar"
              data-title-es="Hotel Superstar"
              type="button"
            >
              <span class="dossier-indicator" aria-hidden="true"></span>
              <div class="dossier-text">
                <span class="dossier-name" data-en="Hotel Superstar" data-es="Hotel Superstar">Hotel Superstar</span>
              </div>
            </button>

            <button
              class="stage-dossier-item"
              role="tab"
              aria-selected="false"
              aria-controls="panel-oasis"
              id="tab-oasis"
              data-target="panel-oasis"
              data-title-en="Adidas Originals"
              data-title-es="Adidas Originals"
              type="button"
            >
              <span class="dossier-indicator" aria-hidden="true"></span>
              <div class="dossier-text">
                <span class="dossier-name" data-en="Adidas Originals" data-es="Adidas Originals">Adidas Originals</span>
              </div>
            </button>
          </div>

          <!-- Stage Viewport Screen -->
          <div class="stage-screen">
            <!-- Slide 1: Sorteo Adidas Oasis -->
            <div
              class="stage-slide active"
              id="panel-sorteo"
              role="tabpanel"
              aria-labelledby="tab-sorteo"
            >
              <div class="stage-media">
                <img
                  src="/images/sorteo-adidas-oasis.webp"
                  alt="Sorteo Adidas Oasis Giveaway Platform Preview"
                  width="1904"
                  height="948"
                  loading="eager"
                  decoding="async"
                />
                <div class="stage-actions">
                  <a href="https://sorteoadidasoasis-p.netlify.app" target="_blank" rel="noopener noreferrer" class="stage-action-btn primary">
                    <span data-en="Live Demo" data-es="Demo en Vivo">
                      <span class="lang-text lang-en">Live Demo</span>
                      <span class="lang-text lang-es">Demo en Vivo</span>
                    </span>
                  </a>
                  <a href="/work#sorteo-adidas-oasis" class="stage-action-btn secondary">
                    <span data-en="Case Study" data-es="Caso de Estudio">
                      <span class="lang-text lang-en">Case Study</span>
                      <span class="lang-text lang-es">Caso de Estudio</span>
                    </span>
                  </a>
                </div>
              </div>
            </div>

            <!-- Slide 2: Superstar -->
            <div
              class="stage-slide"
              id="panel-superstar"
              role="tabpanel"
              aria-labelledby="tab-superstar"
            >
              <div class="stage-media">
                <img
                  src="/images/superstar.webp"
                  alt="Hotel Superstar Portal Preview"
                  width="1904"
                  height="948"
                  loading="lazy"
                  decoding="async"
                />
                <div class="stage-actions">
                  <a href="https://experienciasuperstar-p.netlify.app" target="_blank" rel="noopener noreferrer" class="stage-action-btn primary">
                    <span data-en="Live Demo" data-es="Demo en Vivo">
                      <span class="lang-text lang-en">Live Demo</span>
                      <span class="lang-text lang-es">Demo en Vivo</span>
                    </span>
                  </a>
                  <a href="/work#hotel-superstar" class="stage-action-btn secondary">
                    <span data-en="Case Study" data-es="Caso de Estudio">
                      <span class="lang-text lang-en">Case Study</span>
                      <span class="lang-text lang-es">Caso de Estudio</span>
                    </span>
                  </a>
                </div>
              </div>
            </div>

            <!-- Slide 3: Oasis / Original Forever -->
            <div
              class="stage-slide"
              id="panel-oasis"
              role="tabpanel"
              aria-labelledby="tab-oasis"
            >
              <div class="stage-media">
                <img
                  src="/images/oasis.webp"
                  alt="Original Forever Booking Platform Preview"
                  width="1902"
                  height="942"
                  loading="lazy"
                  decoding="async"
                />
                <div class="stage-actions">
                  <a href="https://slotsadidasoriginals-p.netlify.app" target="_blank" rel="noopener noreferrer" class="stage-action-btn primary">
                    <span data-en="Live Demo" data-es="Demo en Vivo">
                      <span class="lang-text lang-en">Live Demo</span>
                      <span class="lang-text lang-es">Demo en Vivo</span>
                    </span>
                  </a>
                  <a href="/work#original-forever" class="stage-action-btn secondary">
                    <span data-en="Case Study" data-es="Caso de Estudio">
                      <span class="lang-text lang-en">Case Study</span>
                      <span class="lang-text lang-es">Caso de Estudio</span>
                    </span>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Background Signature Wave Art -->
    <WaveArt />
  </main>
</Layout>

<script>
  function setupShowcaseStage() {
    const dossierItems = Array.from(document.querySelectorAll<HTMLButtonElement>('.stage-dossier-item'));
    const slides = Array.from(document.querySelectorAll<HTMLElement>('.stage-slide'));
    const stageScreen = document.querySelector<HTMLElement>('.stage-screen');
    const carouselPrevBtn = document.getElementById('carousel-btn-prev');
    const carouselNextBtn = document.getElementById('carousel-btn-next');
    const carouselTitleEl = document.getElementById('carousel-active-title');

    let currentIndex = 0;

    function activateSlide(index: number) {
      if (index < 0 || index >= slides.length) return;
      currentIndex = index;

      // 1. Update Project Tabs (Desktop sidebar)
      dossierItems.forEach((item, i) => {
        const isActive = i === index;
        item.classList.toggle('active', isActive);
        item.setAttribute('aria-selected', String(isActive));
        item.tabIndex = isActive ? 0 : -1;
      });

      // 2. Update Mobile & Tablet Carousel Header
      if (carouselTitleEl) {
        const targetItem = dossierItems[index];
        const enTitle = targetItem?.getAttribute('data-title-en') || '';
        const esTitle = targetItem?.getAttribute('data-title-es') || '';
        const enSpan = carouselTitleEl.querySelector<HTMLElement>('.lang-en');
        const esSpan = carouselTitleEl.querySelector<HTMLElement>('.lang-es');
        if (enSpan) enSpan.textContent = enTitle;
        if (esSpan) esSpan.textContent = esTitle;
      }

      // 3. Update Slides
      const targetItem = dossierItems[index];
      const targetId = targetItem?.getAttribute('data-target');
      slides.forEach((slide) => {
        const isTarget = slide.id === targetId;
        slide.classList.toggle('active', isTarget);
      });
    }

    // Arrow Button Navigation for Mobile/Tablet Carousel
    carouselPrevBtn?.addEventListener('click', () => {
      activateSlide((currentIndex - 1 + slides.length) % slides.length);
    });

    carouselNextBtn?.addEventListener('click', () => {
      activateSlide((currentIndex + 1) % slides.length);
    });

    // Click & Keyboard Navigation for all viewports
    dossierItems.forEach((item, index) => {
      item.addEventListener('click', () => {
        activateSlide(index);
      });

      item.addEventListener('keydown', (e) => {
        let nextIndex = -1;
        if (e.key === 'ArrowDown' || e.key === 'ArrowRight') {
          nextIndex = (index + 1) % dossierItems.length;
        } else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') {
          nextIndex = (index - 1 + dossierItems.length) % dossierItems.length;
        }

        if (nextIndex !== -1) {
          e.preventDefault();
          activateSlide(nextIndex);
          dossierItems[nextIndex]?.focus();
        }
      });
    });

    // Mobile Swipe Gesture Support
    let touchStartX = 0;
    let touchEndX = 0;
    stageScreen?.addEventListener('touchstart', (e: TouchEvent) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    stageScreen?.addEventListener('touchend', (e: TouchEvent) => {
      touchEndX = e.changedTouches[0].screenX;
      const diff = touchEndX - touchStartX;
      if (Math.abs(diff) > 40) {
        if (diff < 0) {
          activateSlide((currentIndex + 1) % slides.length);
        } else {
          activateSlide((currentIndex - 1 + slides.length) % slides.length);
        }
      }
    }, { passive: true });
  }

  setupShowcaseStage();
  document.addEventListener('astro:page-load', setupShowcaseStage);
</script>
