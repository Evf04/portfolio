---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/main.scss";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Elias Velasquez | Full-Stack Developer",
  description = "Portfolio of Elias Velasquez Fuentes - Systems Engineering student and Full-Stack Developer specializing in Astro, TypeScript, Sass, Supabase, and PostgreSQL.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500&family=Space+Grotesk:wght@500;600;700&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      // Immediate Theme & Language Initialization (runs synchronously in head before first paint to prevent FOUC / layout shift)
      (function() {
        try {
          var savedTheme = localStorage.getItem("preferred-theme");
          if (savedTheme === "light") {
            document.documentElement.classList.add("light-theme");
          }
          var browserLang = navigator.language || navigator.userLanguage || "en";
          var defaultLang = browserLang.startsWith("es") ? "es" : "en";
          var savedLang = localStorage.getItem("preferred-lang") || defaultLang;
          document.documentElement.setAttribute("lang", savedLang);
          document.documentElement.setAttribute("data-lang", savedLang);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <div class="site-shell">
      <Header />
      <slot />
      <Footer />
    </div>

    <script is:inline>
      // Global Theme Management
      if (document.documentElement.classList.contains("light-theme")) {
        document.body.classList.add("light-theme");
      }

      const themeToggle = document.querySelector(".theme-toggle");
      themeToggle?.addEventListener("click", () => {
        const isLight = document.documentElement.classList.toggle("light-theme");
        document.body.classList.toggle("light-theme", isLight);
        localStorage.setItem("preferred-theme", isLight ? "light" : "dark");
      });

      // Global Language Management (EN / ES)
      function updateLanguage(lang) {
        document.documentElement.setAttribute("lang", lang);
        document.documentElement.setAttribute("data-lang", lang);
        const translatable = document.querySelectorAll("[data-en]");
        const langEnSpans = document.querySelectorAll(".lang-en");
        const langEsSpans = document.querySelectorAll(".lang-es");

        translatable.forEach((el) => {
          // If the element has child .lang-text elements, CSS handles rendering with zero layout shift
          if (el.querySelector(".lang-text")) return;

          const text = el.getAttribute(`data-${lang}`);
          if (text && el.textContent !== text) {
            el.textContent = text;
          }
        });

        if (lang === "es") {
          langEnSpans.forEach((s) => s.classList.remove("active"));
          langEsSpans.forEach((s) => s.classList.add("active"));
        } else {
          langEnSpans.forEach((s) => s.classList.add("active"));
          langEsSpans.forEach((s) => s.classList.remove("active"));
        }
      }

      // Initialize language state safely without redundant DOM thrashing
      const initialLang = document.documentElement.getAttribute("lang") || "en";
      updateLanguage(initialLang);

      const langToggle = document.querySelector(".lang-toggle");
      langToggle?.addEventListener("click", () => {
        const currentLang = document.documentElement.getAttribute("lang") || "en";
        const nextLang = currentLang === "en" ? "es" : "en";
        updateLanguage(nextLang);
        localStorage.setItem("preferred-lang", nextLang);
      });
    </script>
  </body>
</html>
